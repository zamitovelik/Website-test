# ── Приложение ───────────────────────────────────────────────────────────────
# Секрет для подписи JWT. Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Время жизни токена входа, в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Откуда разрешены запросы (через запятую). Добавьте сюда прод-домен фронтенда.
# Через запятую. Локальные адреса и опубликованный сайт уже разрешены
# по умолчанию — эту строку можно не задавать вовсе.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://website-murex-two-60.vercel.app
# Необязательный шаблон для превью-сборок, например: ^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# Файл базы данных SQLite
DATABASE_URL=sqlite:///./apogee.db

# ── Почта ────────────────────────────────────────────────────────────────────
# Пока не заполнено — заявки СОХРАНЯЮТСЯ в базу, но письма не уходят.
# Для Gmail нужен пароль приложения (не обычный пароль от аккаунта):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Отправитель и получатель уведомлений
MAIL_FROM=
MAIL_FROM_NAME=Apogee
MAIL_TO=

# ── Telegram ────────────────────────────────────────────────────────────────
# Уведомления о заявках в Telegram. Настраивается командой:
#   python -m scripts.setup_telegram
# Токен бота выдаёт @BotFather, chat_id скрипт определит сам.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Админка ──────────────────────────────────────────────────────────────────
# Токен для доступа к GET /api/admin/leads (заголовок X-Admin-Token)
ADMIN_TOKEN=change-me-too
